#!/usr/bin/env zsh

# Save the caller's `nounset` / `pipefail` state so sourcing this script
# (e.g. from a wrapper function in .zshrc) doesn't leak `set -u` into
# the interactive shell — that would break widgets that read unset
# variables (jira-ticket-summary, zvm, ...). The EXIT trap below
# restores them when the script finishes.
[[ -o nounset ]]  && saved_nounset=1  || saved_nounset=0
[[ -o pipefail ]] && saved_pipefail=1 || saved_pipefail=0
trap '(( saved_nounset ))  || set +u
     (( saved_pipefail )) || set +o pipefail
     unfunction default_branch make_slug compose_branch branch_exists sanitize retitle_iterm_tab report_iterm_cwd launch_in_tmux' EXIT

# _exec-in-worktrunk
# Create a worktree off a base branch and launch a configured CLI in it.
#
# This script is dispatched by symlink: invoke as `claude-in-worktrunk` or
# `opencode-in-worktrunk` and the symlink's basename picks the CLI and its
# predefined args. The no-CLI `shell` mode has no symlink — it must change
# the caller's cwd, so it only works sourced, via the shell-in-worktrunk
# wrapper function in .zshrc (`source _exec-in-worktrunk shell`). The
# dispatch table lives at the bottom of this file.
#
# Branch name: <whoami>/<TICKET-ID>-<llm-slug>  (or <whoami>/<llm-slug>)
#
# Usage: <symlink> [--resume] [--tmux] [base] [ticket-url-or-key]
#        source _exec-in-worktrunk <mode> [--resume] [--tmux] [base] [ticket-url-or-key]
#   --resume  reuse this ticket's existing worktree instead of creating a new one
#   --tmux    run inside a tmux session named after the branch: it survives the
#             terminal window (closing detaches, the CLI keeps running), and
#             `--resume --tmux` reattaches to a still-running session. From
#             iTerm2 control mode (-CC) renders it as a native tab/window.
#             Detached sessions are listed with `tmux ls`.
#   .         branch off the current branch
#   <name>    branch off <name>
#   (empty)   branch off the repo's default branch
#   <url|KEY> a Jira/Linear ticket URL or key (e.g. ABC-123) to slug from
#
# A Jira/Linear ticket URL or key passed as an argument supplies the branch
# slug: its title is shortened via the `llm` CLI. With no ticket argument you're
# asked for a purpose and the slug is generated from that. The clipboard is
# never scanned on its own.

source "${HOME}/bin/_common.zsh"

# Pull in the wt shell wrapper that performs the post-switch `builtin cd`.
# The user's interactive shell has the same line in .zshrc, so `wt switch`
# works there. Inside a script the wrapper isn't loaded and the binary falls
# back to printing the cd path to stdout with a "shell requires restart"
# warning — eval the init here so the script's `wt switch` calls behave
# the same way.
_eval_for_cmd wt "wt config shell init zsh"

set -uo pipefail

model="gemini-flash-latest"

# Default branch: ask origin/HEAD first, then a local main/master/trunk.
default_branch() {
    local b c
    b="$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)"
    b="${b#origin/}"
    if [[ -z "$b" ]]; then
        for c in main master trunk; do
            if git show-ref --verify --quiet "refs/heads/$c"; then b="$c"; break; fi
        done
    fi
    print -r -- "$b"
}

# --- determine mode ----------------------------------------------------------
# The symlink basename (claude-in-worktrunk, opencode-in-worktrunk) picks the
# CLI and its predefined args. When sourced via a wrapper function (e.g.
# `source _exec-in-worktrunk shell`), $0 is the real filename, so the mode is
# taken from the first argument instead — consumed here, before positional
# parsing, or it would be mistaken for the base branch. The $0 guard keeps a
# symlink invocation from eating a base branch named after a mode.
mode="${0##*/}"
if [[ "$mode" != (claude|opencode|shell)-in-worktrunk ]] \
    && (( $# )) && [[ "$1" == (shell|claude|opencode) ]]; then
    mode="$1"
    shift
fi

# --- parse args ------------------------------------------------------------
# A ticket is detected only from a URL the user passes explicitly — never from
# the clipboard on its own. Any argument that looks like a ticket URL/key is
# treated as the ticket source; the remaining positional is the base branch.
resume=0
use_tmux=0
positional=()
ticket_input=""
for a in "$@"; do
    case "$a" in
        --resume)               resume=1 ;;
        --tmux)                 use_tmux=1 ;;
        *://*|*linear.app*)     ticket_input="$a" ;;
        [A-Z][A-Z]*-[0-9]*)     ticket_input="$a" ;;
        *)                      positional+=("$a") ;;
    esac
done

if (( use_tmux )) && ! command -v tmux >/dev/null; then
    print -ru2 -- "--tmux requires tmux (brew install tmux)"
    exit 1
fi

# --- resolve base branch ---------------------------------------------------
arg="${positional[1]-}"
case "$arg" in
    .)  base="$(git rev-parse --abbrev-ref HEAD 2>/dev/null | head -1)" ;;
    "") base="$(default_branch)" ;;
    *)  base="$arg" ;;
esac
if [[ -z "$base" ]]; then
    print -ru2 -- "could not resolve base branch"
    exit 1
fi

# --- find a ticket in the URL the user passed ------------------------------
# Detection runs only against an explicitly-supplied ticket URL/key, so an
# unrelated clipboard never silently steers the branch name.
clip="$ticket_input"
ticket_id=""
ticket_ctx=""
ticket_title=""

# A passed URL holding several tickets is not a request to branch off any one of
# them, so detection is skipped unless exactly one is found.
if grep -qE 'linear\.app/.+/issue/' <<<"$clip"; then
    # Linear: ID and title come straight from the URL, no API needed.
    ids=("${(@f)$(grep -oE 'issue/[A-Za-z0-9]+-[0-9]+' <<<"$clip" | sort -u)}")
    if (( ${#ids} > 1 )); then
        print -ru2 -- "▲ ${#ids} tickets in the URL — ignoring (pass a single ticket to use it)"
    else
        seg="$(grep -oE 'issue/[A-Za-z0-9]+-[0-9]+(/[A-Za-z0-9-]+)?' <<<"$clip" | head -1)"
        seg="${seg#issue/}"
        id="${seg%%/*}"
        ticket_id="${(U)id}"
        title="${seg#*/}"
        [[ "$title" == "$seg" ]] && title=""
        ticket_title="${title//-/ }"
        ticket_ctx="Linear ${ticket_id}: ${ticket_title}"
    fi
else
    raw_ids="$(grep -oE '[A-Z]{2,}-[0-9]+' <<<"$clip" | sort -u)"
    if [[ -n "$raw_ids" ]]; then
        ids=("${(@f)raw_ids}")
        if (( ${#ids} > 1 )); then
            print -ru2 -- "▲ ${#ids} tickets in the URL — ignoring (pass a single ticket to use it)"
        else
            ticket_id="${ids[1]}"
            summary=""
            if [[ -n "${JIRA_SERVER:-}" && -n "${JIRA_USER:-}" && -n "${JIRA_API_TOKEN:-}" ]]; then
                summary="$(http --verify=no GET "${JIRA_SERVER}/rest/api/3/issue/${ticket_id}" \
                    --auth "${JIRA_USER}:${JIRA_API_TOKEN}" 2>/dev/null \
                    | jq -r '.fields.summary // empty' 2>/dev/null || true)"
            fi
            # Only call it Jira when a Jira summary actually came back; a bare ID
            # (e.g. a Linear key) stays generic with no title to slug from.
            if [[ -n "$summary" ]]; then
                ticket_title="$summary"
                ticket_ctx="Jira ${ticket_id}: ${summary}"
            else
                ticket_ctx="ticket ${ticket_id}"
            fi
        fi
    fi
fi

[[ -n "$ticket_ctx" ]] && print -r -- "ticket: ${ticket_ctx}"

# --- helpers ---------------------------------------------------------------
system_prompt='Generate a git branch slug for the described work. Output ONLY the slug inside a single fenced code block. Rules: lowercase, 2-5 words, hyphen-separated, ASCII letters/digits/hyphens only, no spaces, no ticket IDs, no quotes, max ~40 chars.'

sanitize() {
    local s="${(L)1}"
    s="${s//[^a-z0-9-]/-}"
    while [[ "$s" == *--* ]]; do s="${s//--/-}"; done
    s="${s##-}"; s="${s%%-}"
    s="${s[1,40]}"
    print -r -- "${s%%-}"
}

# make_slug <description> -> slug from the llm, falling back to the raw text.
# A second arg of "continue" keeps the prior conversation (llm -c), so refined
# descriptions build on the former prompt and avoid repeating taken names.
make_slug() {
    local raw s
    if [[ "${2-}" == continue ]]; then
        raw="$(llm -x -c -- "That branch name is taken. More context: $1. Propose a different slug." 2>/dev/null || true)"
    else
        local input="Purpose: $1"
        [[ -n "$ticket_ctx" ]] && input+=$'\n'"Context: ${ticket_ctx}"
        raw="$(llm -x -m "$model" -s "$system_prompt" -- "$input" 2>/dev/null || true)"
    fi
    s="$(sanitize "$raw")"
    [[ -z "$s" ]] && s="$(sanitize "$1")"
    print -r -- "$s"
}

user="$(whoami)"
compose_branch() {  # <slug> -> branch name
    if [[ -n "$ticket_id" ]]; then
        print -r -- "${user}/${ticket_id}-$1"
    else
        print -r -- "${user}/$1"
    fi
}

branch_exists() { git show-ref --verify --quiet "refs/heads/$1"; }

# --- resolve the branch ----------------------------------------------------
# Default is to create a new worktree. With --resume, reuse this ticket's
# existing worktree instead of forking a numbered sibling.
existing=""
if (( resume )) && [[ -n "$ticket_id" ]]; then
    existing="$(git for-each-ref --format='%(refname:short)' refs/heads \
        | grep -m1 "^${user}/${ticket_id}-" || true)"
fi

if [[ -n "$existing" ]]; then
    branch="$existing"
    create_args=()
    print -r -- "resuming existing branch ${branch}"
else
    # With a ticket title from the passed URL, shorten it into a slug
    # automatically; otherwise ask for a purpose to describe the work.
    if [[ -n "$ticket_title" ]]; then
        slug="$(make_slug "$ticket_title")"
    else
        read -r "purpose?Purpose of this worktree: "
        slug="$(make_slug "$purpose")"
    fi
    if [[ -z "$slug" ]]; then
        print -ru2 -- "could not generate a branch slug (empty purpose and llm output)"
        exit 1
    fi
    branch="$(compose_branch "$slug")"

    if [[ -n "$ticket_id" ]]; then
        # The slug is derived from the ticket title, so refining it is pointless;
        # if the branch is taken (re-running on the same ticket) just number it.
        if branch_exists "$branch"; then
            n=2
            while branch_exists "${branch}-${n}"; do (( n++ )); done
            branch="${branch}-${n}"
        fi
    else
        # A purpose-derived name clashing with an unrelated branch: ask for a more
        # specific description; Enter falls back to a numeric suffix.
        while branch_exists "$branch"; do
            print -ru2 -- "▲ branch ${branch} already exists"
            read -r "refine?  refine the purpose (Enter to auto-number): "
            if [[ -z "$refine" ]]; then
                n=2
                while branch_exists "${branch}-${n}"; do (( n++ )); done
                branch="${branch}-${n}"
                break
            fi
            slug="$(make_slug "$refine" continue)"
            [[ -n "$slug" ]] && branch="$(compose_branch "$slug")"
        done
    fi
    create_args=(--create --base "$base")
fi

# Session name: the branch without its <whoami>/ prefix.
session_name="${branch#${user}/}"

# --- iTerm2 tab title -------------------------------------------------------
# Name the tab after the session so parallel worktree sessions can be told
# apart at a glance. A one-shot escape isn't enough: iTerm2's automatic
# session naming ("job in dir") recomputes when the foreground job changes —
# i.e. moments after the CLI launches — and clobbers OSC- and user-set names
# alike. So the OSC 1 below only covers the stretch until the CLI starts,
# and retitle_iterm_tab re-asserts the name afterwards at the user level via
# AppleScript: post-launch user-level names survive job changes and are only
# recomputed at the next shell prompt, which never comes in --execute mode.
retitle_iterm_tab() {
    [[ "${TERM_PROGRAM:-}" == "iTerm.app" && -n "${ITERM_SESSION_ID:-}" ]] || return 0
    local uuid="${ITERM_SESSION_ID#*:}"
    ( for delay in 4 6 8 12 20 30; do
        sleep "$delay"
        osascript \
            -e 'on run argv' \
            -e 'tell application "iTerm2"' \
            -e 'repeat with w in windows' \
            -e 'repeat with t in tabs of w' \
            -e 'repeat with s in sessions of t' \
            -e 'if id of s is item 1 of argv then set name of s to item 2 of argv' \
            -e 'end repeat' -e 'end repeat' -e 'end repeat' \
            -e 'end tell' -e 'end run' \
            "$uuid" "$1"
    done ) &>/dev/null &!
}
if (( ! use_tmux )) && [[ "${TERM_PROGRAM:-}" == "iTerm.app" && -t 1 ]]; then
    printf '\e]1;%s\a' "$session_name"
fi

# Report the current directory to iTerm2. iTerm2 normally learns the cwd
# from shell-integration prompt marks, but in --execute-style CLI modes no
# prompt ever runs, so features that rely on it (new tab/split in same
# directory, status-bar path, semantic history) would keep the pre-switch
# directory for the whole session.
report_iterm_cwd() {
    [[ "${TERM_PROGRAM:-}" == "iTerm.app" && -t 1 ]] || return 0
    printf '\e]1337;CurrentDir=%s\a' "$PWD"
}

# --- tmux launch -------------------------------------------------------------
# With --tmux the CLI runs inside a tmux session named after the branch, so
# it outlives the terminal window. All of the iTerm2 title/cwd machinery
# above is skipped in this mode: iTerm2 in control mode takes tab title and
# cwd straight from tmux. `-n` pins the window name (naming a window at
# creation disables tmux's automatic-rename for it), but that alone doesn't
# name the tab: iTerm2 -CC labels tabs with the pane title (#{pane_title}),
# not the window name, and Claude Code writes its own
# "<repo> · <session> · <id>" pane title through escapes that
# CLAUDE_CODE_DISABLE_TERMINAL_TITLE no longer fully suppresses (seen with
# 2.1.x). So for CLI modes the pane title is pinned to the session name and
# `allow-set-title off` blocks the CLI's title escapes at the tmux layer.
# Shell mode keeps the default: the interactive shell legitimately
# re-titles its pane ("zsh in <dir>").
#
# PATH is forwarded with -e: a tmux server that is already running keeps the
# environment it was started with, which may predate the version managers
# this script eval'd, and PATH is not in tmux's default update-environment
# list.
launch_in_tmux() {
    # Plain tmux calls, not _exec: its eval would re-parse "=name" targets
    # (zsh =word expansion), its "Executing" line would dump the whole
    # forwarded PATH, and --silent's output capture would eat control mode.
    # "=" forces an exact session match — numbered branch variants are
    # prefixes of each other.
    if ! tmux has-session -t "=${session_name}" 2>/dev/null; then
        tmux new-session -d -s "$session_name" -n "$session_name" \
            -c "$PWD" -e "PATH=${PATH}" "${cli[@]}" "${cli_args[@]}" \
            || return 1
        if (( ${#cli[@]} )); then
            tmux set-option -w -t "=${session_name}:" allow-set-title off
            tmux select-pane -t "=${session_name}:" -T "$session_name"
        fi
    fi
    if [[ -n "${TMUX:-}" ]]; then
        # Already inside tmux: never nest a client — move this client over.
        tmux switch-client -t "=${session_name}"
    else
        local client=(tmux)
        # Control mode only makes sense from iTerm2 (Settings → General →
        # tmux decides whether the session opens as a native tab or window).
        # Everywhere else a plain attached tmux still buys persistence.
        [[ "${TERM_PROGRAM:-}" == "iTerm.app" ]] && client+=(-CC)
        # Attaching to an already-existing session is what makes --resume
        # pick up a still-running CLI.
        print -r -- "tmux session: ${session_name}"
        "${client[@]}" attach-session -t "=${session_name}"
    fi
}

# --- dispatch --------------------------------------------------------------
# Add another tool by dropping a case here and symlinking
# `<tool>-in-worktrunk` -> this file. `shell` is the no-CLI variant (sourced,
# no symlink): it just creates/switches the worktree without spawning a child
# process — the user stays in their original shell.
cli=()
cli_args=()
case "$mode" in
    claude-in-worktrunk|claude)
        # Claude Code keeps rewriting the terminal title while it runs, which
        # clobbers the session-name tab title set above. Route through `env`
        # to disable that for the child only — exporting here would leak into
        # the caller's shell when this script is sourced.
        cli=(env)
        cli_args=(CLAUDE_CODE_DISABLE_TERMINAL_TITLE=1
                  claude --dangerously-skip-permissions --name "$session_name")
        ;;
    opencode-in-worktrunk|opencode)
        cli=(opencode)
        cli_args=()
        ;;
    shell-in-worktrunk|shell)
        cli=()
        cli_args=()
        ;;
    *)
        print -ru2 -- "invoke via claude-in-worktrunk, opencode-in-worktrunk, or the shell-in-worktrunk function (got: $mode)"
        exit 1
        ;;
esac

# The wt wrapper loaded above does the post-switch `builtin cd`, so after
# this call the script (or the sourcing shell) sits inside the worktree and
# its path can be reported to iTerm2. That's why the switch and the CLI
# launch are separate steps rather than one `wt switch --execute`: --execute
# replaces the wt process with the CLI, so the worktree path would never be
# observable from here.
_exec wt switch "$branch" "${create_args[@]}"

if (( use_tmux )); then
    # In shell mode (empty cli) tmux gets no command and opens the default
    # shell in the worktree, so --tmux works from the symlinks and sourced
    # alike — the tmux pane does the cd, not the caller.
    launch_in_tmux
else
    report_iterm_cwd
    if (( ${#cli[@]} )); then
        # Only CLI modes get the re-asserter: in shell mode the prompt returns
        # and iTerm2's auto-naming would legitimately take over again.
        retitle_iterm_tab "$session_name"
        _exec "${cli[@]}" "${cli_args[@]}"
    fi
fi
