#!/usr/bin/env zsh

# Save the caller's `nounset` / `pipefail` state so sourcing this script
# (e.g. from a wrapper function in .zshrc) doesn't leak `set -u` into
# the interactive shell — that would break widgets that read unset
# variables (jira-ticket-summary, zvm, ...). The EXIT trap below
# restores them when the script finishes.
[[ -o nounset ]]  && saved_nounset=1  || saved_nounset=0
[[ -o pipefail ]] && saved_pipefail=1 || saved_pipefail=0
trap '(( saved_nounset ))  || set +u
     (( saved_pipefail )) || set +o pipefail
     unfunction default_branch in_linked_worktree make_slug compose_branch branch_exists sanitize fetch_url_context sentry_auth_token resolve_sentry_issue resolve_ticket_source retitle_iterm_tab report_iterm_cwd launch_in_cmux rename_cmux_workspace launch_in_herdr rename_herdr_workspace launch_in_tmux offer_worktree_cleanup 2>/dev/null' EXIT

# _exec-in-worktrunk
# Create a worktree off a base branch and launch a configured CLI in it.
#
# This script is dispatched by symlink: invoke as `claude-in-worktrunk` or
# `opencode-in-worktrunk` and the symlink's basename picks the CLI and its
# predefined args. The no-CLI `shell` mode has no symlink — it must change
# the caller's cwd, so it only works sourced, via the shell-in-worktrunk
# wrapper function in .zshrc (`source _exec-in-worktrunk shell`). The
# dispatch table lives at the bottom of this file.
#
# Branch name: <whoami>/<TICKET-ID>-<llm-slug>  (or <whoami>/<llm-slug>)
#
# Usage: <symlink> [--resume] [--cmux|--tmux|--herdr] [base] [ticket-url-or-key]
#        source _exec-in-worktrunk <mode> [--resume] [--cmux|--tmux|--herdr] [base] [ticket-url-or-key]
#   --resume  reuse this ticket's existing worktree instead of creating a new one
#   --cmux    run inside a cmux workspace named after the branch. cmux is a
#             persistent GUI multiplexer (a separate app driven over a Unix
#             socket), so the workspace outlives this terminal window and
#             survives an app restart — closing the window leaves the CLI
#             running, and `--resume --cmux` returns to it. Open workspaces
#             are listed with `cmux workspace list`. When the script is already
#             running inside a cmux surface, --cmux is a no-op: rather than spawn
#             a twin, it renames the current workspace after the branch and runs
#             the tool in place (this happens with or without the flag).
#   --tmux    run inside a tmux session named after the branch, regardless of the
#             host terminal. Like cmux the session is persistent — detach and
#             `--resume --tmux` (or just re-running with the same branch) returns
#             to it.
#   --herdr   run inside a herdr workspace named after the branch. herdr is a
#             client/server terminal multiplexer (tmux-like, driven over a
#             Unix socket) whose workspaces can be git-worktree-aware: the
#             worktree is registered via `herdr worktree open`, so the
#             workspace shows its branch and repo in the UI, tracks the agent's
#             idle/working/blocked state, and `herdr worktree remove` can
#             reclaim the checkout later. The server outlives this terminal,
#             and opening is idempotent per checkout path — re-running on the
#             same branch (with or without --resume) returns to the existing
#             workspace instead of spawning a twin. When the CLI exits, the
#             worktree-cleanup offer (below) runs in the workspace's shell, and
#             the workspace closes once the worktree is removed. Inside a herdr
#             pane the flag is a no-op like --cmux inside cmux: the current
#             workspace is renamed after the branch and the tool runs in place.
#             --cmux / --tmux / --herdr are mutually exclusive.
#   .         branch off the current branch
#   <name>    branch off <name>
#   (empty)   branch off the repo's default branch
#   <url|KEY> a ticket URL or key (e.g. ABC-123), or any other URL, to slug from
#
# Run from inside a linked worktree, the script first asks whether to stay on
# the branch already checked out there instead of carving out another worktree.
# Answering yes skips branch naming (and its ticket lookup) entirely and runs
# the tool right here. See the "already in a worktree" section.
#
# When the tool exits, a clean worktree is offered for removal (the branch is
# kept, so `wt switch <branch>` brings it back). See offer_worktree_cleanup
# and the standalone _offer-worktree-cleanup it wraps.
#
# A Jira/Linear/Sentry ticket URL or key passed as an argument supplies the
# branch slug: its title (and description excerpt) is fetched — Jira via the
# `jira` CLI or JIRA_* REST, GitHub issues/PRs via `gh`, Sentry issues via its
# REST API, any other URL via curl — and shortened via the `llm` CLI. With no
# ticket argument you're asked for a purpose; a single URL inside that answer
# is resolved the same way. The clipboard is never scanned on its own.

source "${HOME}/bin/_common.zsh"

# Pull in the wt shell wrapper that performs the post-switch `builtin cd`.
# The user's interactive shell has the same line in .zshrc, so `wt switch`
# works there. Inside a script the wrapper isn't loaded and the binary falls
# back to printing the cd path to stdout with a "shell requires restart"
# warning — eval the init here so the script's `wt switch` calls behave
# the same way.
_eval_for_cmd wt "wt config shell init zsh"

set -uo pipefail

model="gemini-flash-latest"

# Default branch: ask origin/HEAD first, then a local main/master/trunk.
default_branch() {
    local b c
    b="$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)"
    b="${b#origin/}"
    if [[ -z "$b" ]]; then
        for c in main master trunk; do
            if git show-ref --verify --quiet "refs/heads/$c"; then b="$c"; break; fi
        done
    fi
    print -r -- "$b"
}

# True when the cwd sits in a linked worktree rather than the repo's main
# checkout: there $GIT_DIR is .git/worktrees/<name> while the common dir stays
# the shared .git, and in the main worktree the two are the same path.
in_linked_worktree() {
    local gd common
    gd="$(git rev-parse --absolute-git-dir 2>/dev/null)" || return 1
    common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
    [[ -n "$gd" && -n "$common" && "$gd" != "$common" ]]
}

# --- determine mode ----------------------------------------------------------
# The symlink basename (claude-in-worktrunk, opencode-in-worktrunk) picks the
# CLI and its predefined args. When sourced via a wrapper function (e.g.
# `source _exec-in-worktrunk shell`), $0 is the real filename, so the mode is
# taken from the first argument instead — consumed here, before positional
# parsing, or it would be mistaken for the base branch. The $0 guard keeps a
# symlink invocation from eating a base branch named after a mode.
mode="${0##*/}"
if [[ "$mode" != (claude|opencode|shell)-in-worktrunk ]] \
    && (( $# )) && [[ "$1" == (shell|claude|opencode) ]]; then
    mode="$1"
    shift
fi

# --- parse args ------------------------------------------------------------
# A ticket is detected only from a URL the user passes explicitly — never from
# the clipboard on its own. Any argument that looks like a ticket URL/key is
# treated as the ticket source; the remaining positional is the base branch.
resume=0
use_cmux=0
use_tmux=0
use_herdr=0
positional=()
ticket_input=""
for a in "$@"; do
    case "$a" in
        --resume)               resume=1 ;;
        --cmux)                 use_cmux=1 ;;
        --tmux)                 use_tmux=1 ;;
        --herdr)                use_herdr=1 ;;
        *://*|*linear.app*)     ticket_input="$a" ;;
        [A-Z][A-Z]*-[0-9]*)     ticket_input="$a" ;;
        *)                      positional+=("$a") ;;
    esac
done

if (( use_cmux + use_tmux + use_herdr > 1 )); then
    print -ru2 -- "choose one of --cmux / --tmux / --herdr"
    exit 1
fi
if (( use_cmux )) && ! command -v cmux >/dev/null; then
    print -ru2 -- "--cmux requires cmux (brew install --cask cmux)"
    exit 1
fi
if (( use_tmux )) && ! command -v tmux >/dev/null; then
    print -ru2 -- "--tmux requires tmux (brew install tmux)"
    exit 1
fi
if (( use_herdr )) && ! command -v herdr >/dev/null; then
    print -ru2 -- "--herdr requires herdr (brew install herdr)"
    exit 1
fi

# --- already in a worktree? -------------------------------------------------
# Launched from inside a linked worktree, carving out another one is often not
# what's wanted — the work frequently belongs to the branch already checked out
# here. Ask, and on yes run the tool in place: no ticket lookup, no slug, no
# `wt switch`. Enter keeps the old behavior (a fresh worktree). The question is
# skipped when the answer is already implied (--resume names the ticket's own
# worktree) or there is no one to ask (non-interactive).
stay=0
current_branch=""
if (( ! resume )) && [[ -t 0 ]] && in_linked_worktree; then
    current_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
    read -r "stay_answer?in worktree '$(git rev-parse --show-toplevel)' on ${current_branch} — stay here? [y/N] "
    [[ "$stay_answer" == [Yy]* ]] && stay=1
fi

# --- resolve base branch ---------------------------------------------------
# Only a new worktree needs a base to branch from; staying put uses the branch
# that is already here, so the lookup (and its failure mode) is skipped.
if (( ! stay )); then
    arg="${positional[1]-}"
    case "$arg" in
        .)  base="$(git rev-parse --abbrev-ref HEAD 2>/dev/null | head -1)" ;;
        "") base="$(default_branch)" ;;
        *)  base="$arg" ;;
    esac
    if [[ -z "$base" ]]; then
        print -ru2 -- "could not resolve base branch"
        exit 1
    fi
fi

# --- ticket / URL context ---------------------------------------------------
# Detection runs only against an explicitly-supplied ticket URL/key or a URL
# the user types into the purpose prompt, so an unrelated clipboard never
# silently steers the branch name.

# fetch_url_context <url> — best-effort fetch of an arbitrary URL. Prints the
# page <title> on the first line and a plain-text rendering of the body after
# it (via textutil, a macOS built-in); any failure is silent so callers can
# fall back to the raw text. Only reaches public pages — auth-walled Jira goes
# through the jira CLI / REST and GitHub through the gh fast-path in
# resolve_ticket_source.
fetch_url_context() {
    local html title
    # `command` dodges interactive aliases: this file is sourced into the
    # user's shell in shell mode, where curl is aliased to curlie and would
    # be baked into the function at parse time.
    html="$(command curl -fsSL --max-time 15 "$1" 2>/dev/null)" || return 1
    [[ -n "$html" ]] || return 1
    title="$(grep -oE '<title[^>]*>[^<]+' <<<"$html" | head -1)"
    print -r -- "${title#*>}"
    textutil -stdin -stdout -convert txt -format html <<<"$html" 2>/dev/null
}

# sentry_auth_token — bearer token for the Sentry API: $SENTRY_AUTH_TOKEN
# first, else the `[auth] token` line in ~/.sentryclirc that `sentry-cli login`
# writes. Prints nothing and fails when neither is present.
sentry_auth_token() {
    if [[ -n "${SENTRY_AUTH_TOKEN:-}" ]]; then
        print -r -- "$SENTRY_AUTH_TOKEN"
        return 0
    fi
    [[ -r "${HOME}/.sentryclirc" ]] || return 1
    local t
    t="$(awk -F= '/^[[:space:]]*token[[:space:]]*=/{print $2; exit}' "${HOME}/.sentryclirc")"
    t="${t//[[:space:]\'\"]/}"
    [[ -n "$t" ]] || return 1
    print -r -- "$t"
}

# resolve_sentry_issue <text> — a Sentry issue names the work the same way a
# ticket does, so its title becomes the branch slug. The web URL is
# org-scoped (https://<org>.sentry.io/issues/<id>/) while the API is not, so
# the org is recovered from the subdomain or from an /organizations/<org>/
# path segment and spliced into /api/0/organizations/<org>/issues/<id>/, which
# both sentry.io and self-hosted installs serve on their own host. Auth is
# required: the issue page renders client-side, so fetch_url_context would come
# back with nothing to slug from.
#
# ticket_id is set to Sentry's short ID (LESGARDIENS-IOS-3), which doubles as
# the token Sentry looks for in commit messages ("Fixes LESGARDIENS-IOS-3") to
# resolve the issue on deploy.
resolve_sentry_issue() {
    local url host org id tok json title culprit project level count
    url="$(grep -oE 'https?://[^[:space:]]+' <<<"$1" | head -1)"
    while [[ "$url" == *[.,\;:\)\"\'] ]]; do url="${url%?}"; done
    host="${${url#*://}%%/*}"
    id="$(grep -oE 'issues/[0-9]+' <<<"$url" | head -1)"; id="${id#issues/}"
    org="$(grep -oE 'organizations/[^/?#]+' <<<"$url" | head -1)"; org="${org#organizations/}"
    if [[ -z "$org" ]]; then
        [[ "$host" == *.sentry.io ]] && org="${host%.sentry.io}"
        [[ -z "$org" ]] && org="${SENTRY_ORG:-}"
    fi
    if [[ -z "$id" || -z "$org" ]]; then
        print -ru2 -- "▲ could not read org/issue id out of the Sentry URL"
        return 1
    fi

    tok="$(sentry_auth_token)" || {
        print -ru2 -- "▲ no Sentry token (set SENTRY_AUTH_TOKEN or run: sentry-cli login)"
        return 1
    }
    print -r -- "fetching Sentry issue ${id} ..."
    json="$(command curl -fsSL --max-time 15 \
        -H "Authorization: Bearer ${tok}" \
        "https://${host}/api/0/organizations/${org}/issues/${id}/" 2>/dev/null)" || {
        print -ru2 -- "▲ Sentry API did not return issue ${id} (org ${org})"
        return 1
    }

    title="$(jq -r '.title // empty' <<<"$json" 2>/dev/null || true)"
    [[ -n "$title" ]] || return 1
    ticket_id="$(jq -r '.shortId // empty' <<<"$json" 2>/dev/null || true)"
    culprit="$(jq -r '.culprit // empty' <<<"$json" 2>/dev/null || true)"
    project="$(jq -r '.project.slug // empty' <<<"$json" 2>/dev/null || true)"
    level="$(jq -r '.level // empty' <<<"$json" 2>/dev/null || true)"
    count="$(jq -r '.count // empty' <<<"$json" 2>/dev/null || true)"
    ticket_title="$title"
    ticket_ctx="Sentry ${ticket_id:-$id}: ${title}"
    # The trailer lines only reach the llm — the headline above is all that is
    # printed — so they carry whatever else narrows down what broke.
    [[ -n "$project" ]] && ticket_ctx+=$'\n'"project: ${project} (${level:-error}, ${count:-?} events)"
    [[ -n "$culprit" ]] && ticket_ctx+=$'\n'"culprit: ${culprit}"
    return 0
}

# resolve_ticket_source <text> — find a ticket or context URL in <text> and
# populate ticket_id / ticket_title / ticket_ctx. Known hosts resolve fast:
# Linear from the URL slug (or the linear CLI where installed), Sentry issues
# via its REST API, Jira via the jira CLI with a JIRA_* REST fallback, GitHub
# issues/PRs via gh. Any other URL goes through fetch_url_context. Failures
# leave the variables as they were, so callers keep the plain raw-text
# behavior.
resolve_ticket_source() {
    local text="$1"
    # <text> holding several tickets is not a request to branch off any one of
    # them, so detection is skipped unless exactly one is found.
    if grep -qE 'linear\.app/.+/issue/' <<<"$text"; then
        # Linear: ID and title come straight from the URL, no API needed.
        local -a ids
        ids=("${(@f)$(grep -oE 'issue/[A-Za-z0-9]+-[0-9]+' <<<"$text" | sort -u)}")
        if (( ${#ids} > 1 )); then
            print -ru2 -- "▲ ${#ids} tickets in the URL — ignoring (pass a single ticket to use it)"
        else
            local seg id title
            seg="$(grep -oE 'issue/[A-Za-z0-9]+-[0-9]+(/[A-Za-z0-9-]+)?' <<<"$text" | head -1)"
            seg="${seg#issue/}"
            id="${seg%%/*}"
            ticket_id="${(U)id}"
            title="${seg#*/}"
            [[ "$title" == "$seg" ]] && title=""
            ticket_title="${title//-/ }"
            ticket_ctx="Linear ${ticket_id}: ${ticket_title}"
            # A linear CLI, where installed, upgrades the URL-slug title (often
            # truncated or missing) to the real title plus description excerpt.
            if command -v linear >/dev/null; then
                local lout
                lout="$(linear issue view "$ticket_id" 2>/dev/null || true)"
                if [[ -n "$lout" ]]; then
                    ticket_title="${lout%%$'\n'*}"
                    ticket_ctx="Linear ${ticket_id}: ${ticket_title}"$'\n'"${lout[1,500]}"
                fi
            fi
        fi
    elif grep -qE 'https?://[^/[:space:]]*sentry[^/[:space:]]*/[^[:space:]]*issues/[0-9]+' <<<"$text"; then
        # "sentry" has to sit in the host, not just anywhere in the URL, or
        # github.com/getsentry/sentry/issues/123 would be sent to the Sentry
        # API instead of gh. A self-hosted install on a host without "sentry"
        # in its name falls through to the generic URL fetch below.
        resolve_sentry_issue "$text" || true
    else
        local raw_ids
        # Project keys may carry digits after the leading letter (MSP7-67),
        # so the key part is [A-Z][A-Z0-9]+ rather than letters-only.
        raw_ids="$(grep -oE '[A-Z][A-Z0-9]+-[0-9]+' <<<"$text" | sort -u)"
        if [[ -n "$raw_ids" ]]; then
            local -a ids
            ids=("${(@f)raw_ids}")
            if (( ${#ids} > 1 )); then
                print -ru2 -- "▲ ${#ids} tickets in the URL — ignoring (pass a single ticket to use it)"
            else
                local summary="" desc="" raw
                ticket_id="${ids[1]}"
                # The jira CLI carries its own auth config, so it works where
                # the JIRA_* env vars for the REST fallback aren't set. The
                # description is ADF JSON; flatten its text nodes for the llm.
                if command -v jira >/dev/null; then
                    raw="$(jira issue view "$ticket_id" --raw 2>/dev/null || true)"
                    if [[ -n "$raw" ]]; then
                        summary="$(jq -r '.fields.summary // empty' <<<"$raw" 2>/dev/null || true)"
                        desc="$(jq -r '[.fields.description | .. | .text? // empty] | join(" ")' <<<"$raw" 2>/dev/null || true)"
                    fi
                fi
                if [[ -z "$summary" && -n "${JIRA_SERVER:-}" && -n "${JIRA_USER:-}" && -n "${JIRA_API_TOKEN:-}" ]]; then
                    summary="$(http --verify=no GET "${JIRA_SERVER}/rest/api/3/issue/${ticket_id}" \
                        --auth "${JIRA_USER}:${JIRA_API_TOKEN}" 2>/dev/null \
                        | jq -r '.fields.summary // empty' 2>/dev/null || true)"
                fi
                # Only call it Jira when a Jira summary actually came back; a bare ID
                # (e.g. a Linear key) stays generic with no title to slug from.
                if [[ -n "$summary" ]]; then
                    ticket_title="$summary"
                    ticket_ctx="Jira ${ticket_id}: ${summary}"
                    [[ -n "$desc" ]] && ticket_ctx+=$'\n'"${desc[1,500]}"
                else
                    ticket_ctx="ticket ${ticket_id}"
                fi
            fi
        elif [[ "$text" == *://* ]]; then
            # Not a ticket system resolvable locally: fetch the page itself.
            # GitHub issues/PRs go through gh (instant, authenticated, clean
            # title/body); any other URL is fetched with curl and rendered to
            # text, and the excerpt is handed to the llm as slugging context.
            local url json title="" body=""
            url="$(grep -oE 'https?://[^[:space:]]+' <<<"$text" | head -1)"
            # Trim punctuation that prose drags along ("see <url>.").
            while [[ "$url" == *[.,\;:\)\"\'] ]]; do url="${url%?}"; done
            if [[ "$url" =~ 'github\.com/[^/]+/[^/]+/(issues|pull)/[0-9]+' ]] && command -v gh >/dev/null; then
                case "$url" in
                    */pull/*) json="$(gh pr view "$url" --json title,body 2>/dev/null || true)" ;;
                    *)        json="$(gh issue view "$url" --json title,body 2>/dev/null || true)" ;;
                esac
                if [[ -n "$json" ]]; then
                    title="$(jq -r '.title // empty' <<<"$json" 2>/dev/null || true)"
                    body="$(jq -r '.body // empty' <<<"$json" 2>/dev/null || true)"
                fi
            fi
            if [[ -z "$title" ]]; then
                local page
                print -r -- "fetching ${url} ..."
                page="$(fetch_url_context "$url" || true)"
                if [[ -n "$page" ]]; then
                    title="${page%%$'\n'*}"
                    body="${page#*$'\n'}"
                    [[ "$body" == "$page" ]] && body=""
                    # Pages without a <title> still contribute their text; the
                    # URL itself stands in as the headline.
                    [[ -z "$title" ]] && title="$url"
                fi
            fi
            if [[ -n "$title" ]]; then
                ticket_title="$title"
                ticket_ctx="$title"
                [[ -n "$body" ]] && ticket_ctx+=$'\n'"${body[1,500]}"
            fi
        fi
    fi
    # Only the headline reaches the terminal; fetched bodies stay in the
    # context handed to the llm.
    [[ -n "$ticket_ctx" ]] && print -r -- "ticket: ${ticket_ctx%%$'\n'*}"
    return 0
}

ticket_id=""
ticket_ctx=""
ticket_title=""
# Nothing to slug when staying put, so the fetch is skipped along with it.
if (( ! stay )) && [[ -n "$ticket_input" ]]; then
    resolve_ticket_source "$ticket_input"
fi

# --- helpers ---------------------------------------------------------------
system_prompt='Generate a git branch slug for the described work. Output ONLY the slug inside a single fenced code block. Rules: lowercase, 2-5 words, hyphen-separated, ASCII letters/digits/hyphens only, no spaces, no ticket IDs, no quotes, max ~40 chars.'

# Ticket titles are often cryptic — tracker shorthand, component tags
# ("[iOS] FE:"), abbreviations, codenames — so slugging one verbatim just
# transliterates the noise. This variant tells the llm to decode the title
# (the description excerpt travels along in ticket_ctx) and restate the
# actual work; a title that is already clear passes through condensed.
ticket_system_prompt='You are given a ticket title, possibly with a description excerpt as context. Generate a git branch slug for it. If the title is already clear, condense it into the slug. If it is cryptic (abbreviations, component tags, codenames, tracker shorthand), use the context to restate the actual work in plain words — expand or drop the cryptic fragments rather than copying them. Output ONLY the slug inside a single fenced code block. Rules: lowercase, 2-5 words, hyphen-separated, ASCII letters/digits/hyphens only, no spaces, no ticket IDs, no quotes, max ~40 chars.'

sanitize() {
    local s="${(L)1}"
    s="${s//[^a-z0-9-]/-}"
    while [[ "$s" == *--* ]]; do s="${s//--/-}"; done
    s="${s##-}"; s="${s%%-}"
    s="${s[1,40]}"
    print -r -- "${s%%-}"
}

# make_slug <description> [continue|ticket] -> slug from the llm, falling
# back to the raw text. "continue" keeps the prior conversation (llm -c), so
# refined descriptions build on the former prompt and avoid repeating taken
# names. "ticket" marks <description> as a ticket title and swaps in the
# polish prompt above.
make_slug() {
    local raw s
    if [[ "${2-}" == continue ]]; then
        raw="$(llm -x -c -- "That branch name is taken. More context: $1. Propose a different slug." 2>/dev/null || true)"
    else
        local sys="$system_prompt" input="Purpose: $1"
        if [[ "${2-}" == ticket ]]; then
            sys="$ticket_system_prompt"
            input="Ticket title: $1"
        fi
        [[ -n "$ticket_ctx" ]] && input+=$'\n'"Context: ${ticket_ctx}"
        raw="$(llm -x -m "$model" -s "$sys" -- "$input" 2>/dev/null || true)"
    fi
    s="$(sanitize "$raw")"
    [[ -z "$s" ]] && s="$(sanitize "$1")"
    print -r -- "$s"
}

user="$(whoami)"
compose_branch() {  # <slug> -> branch name
    if [[ -n "$ticket_id" ]]; then
        print -r -- "${user}/${ticket_id}-$1"
    else
        print -r -- "${user}/$1"
    fi
}

branch_exists() { git show-ref --verify --quiet "refs/heads/$1"; }

# --- resolve the branch ----------------------------------------------------
# Default is to create a new worktree. With --resume, reuse this ticket's
# existing worktree instead of forking a numbered sibling.
existing=""
if (( resume )) && [[ -n "$ticket_id" ]]; then
    existing="$(git for-each-ref --format='%(refname:short)' refs/heads \
        | grep -m1 "^${user}/${ticket_id}-" || true)"
fi

if (( stay )); then
    # Staying in this worktree: its checked-out branch is the branch, and there
    # is nothing to create.
    branch="$current_branch"
    create_args=()
elif [[ -n "$existing" ]]; then
    branch="$existing"
    create_args=()
    print -r -- "resuming existing branch ${branch}"
else
    # With a ticket title from the passed URL, polish it into a slug
    # automatically; otherwise ask for a purpose to describe the work.
    if [[ -n "$ticket_title" ]]; then
        slug="$(make_slug "$ticket_title" ticket)"
    else
        read -r "purpose?Purpose of this worktree: "
        # A single URL inside the purpose is resolved like a passed ticket
        # URL: it can supply ticket_id (the branch prefix) and feeds
        # ticket_ctx into the slug prompt. Several URLs are ambiguous and
        # ignored, mirroring the multi-ticket guard above.
        purpose_urls="$(grep -oE 'https?://[^[:space:]]+' <<<"$purpose" | sort -u)"
        if [[ -n "$purpose_urls" ]]; then
            urls=("${(@f)purpose_urls}")
            if (( ${#urls} > 1 )); then
                print -ru2 -- "▲ ${#urls} URLs in the purpose — ignoring (include a single URL to fetch it)"
            else
                resolve_ticket_source "${urls[1]}"
            fi
        fi
        slug="$(make_slug "$purpose")"
    fi
    if [[ -z "$slug" ]]; then
        print -ru2 -- "could not generate a branch slug (empty purpose and llm output)"
        exit 1
    fi
    branch="$(compose_branch "$slug")"

    if [[ -n "$ticket_id" ]]; then
        # The slug is derived from the ticket title, so refining it is pointless;
        # if the branch is taken (re-running on the same ticket) just number it.
        if branch_exists "$branch"; then
            n=2
            while branch_exists "${branch}-${n}"; do (( n++ )); done
            branch="${branch}-${n}"
        fi
    else
        # A purpose-derived name clashing with an unrelated branch: ask for a more
        # specific description; Enter falls back to a numeric suffix.
        while branch_exists "$branch"; do
            print -ru2 -- "▲ branch ${branch} already exists"
            read -r "refine?  refine the purpose (Enter to auto-number): "
            if [[ -z "$refine" ]]; then
                n=2
                while branch_exists "${branch}-${n}"; do (( n++ )); done
                branch="${branch}-${n}"
                break
            fi
            slug="$(make_slug "$refine" continue)"
            [[ -n "$slug" ]] && branch="$(compose_branch "$slug")"
        done
    fi
    create_args=(--create --base "$base")
fi

# Session name: the branch without its <whoami>/ prefix. tmux rejects `.` and
# `:` in session names, so it gets its own sanitized spelling — the cleanup
# check below has to address the same session launch_in_tmux created.
session_name="${branch#${user}/}"
tmux_session="${session_name//[.:]/-}"

# --- where does the tool run? ----------------------------------------------
# --tmux wins everywhere (run in tmux regardless of terminal). Otherwise a
# multiplexer we are already inside claims the run: in a herdr pane or a cmux
# surface, the current workspace is renamed after the branch and the tool runs
# in place — spawning a new one would be a pointless twin, so --herdr/--cmux
# are no-ops there. herdr is checked first: its client runs inside a terminal,
# so a herdr pane hosted in a cmux surface carries both IDs and herdr is the
# innermost. A --cmux or --herdr from any other terminal creates a fresh
# workspace in that multiplexer; with no flag we just run in the current
# terminal.
in_cmux=0;  [[ -n "${CMUX_WORKSPACE_ID:-}" ]]  && in_cmux=1
in_herdr=0; [[ -n "${HERDR_WORKSPACE_ID:-}" ]] && in_herdr=1
if   (( use_tmux  )); then launch_target=tmux
elif (( in_herdr  )); then launch_target=herdr-inplace
elif (( in_cmux   )); then launch_target=cmux-inplace
elif (( use_cmux  )); then launch_target=cmux-create
elif (( use_herdr )); then launch_target=herdr-create
else                       launch_target=plain
fi

# --- iTerm2 tab title -------------------------------------------------------
# Name the tab after the session so parallel worktree sessions can be told
# apart at a glance. A one-shot escape isn't enough: iTerm2's automatic
# session naming ("job in dir") recomputes when the foreground job changes —
# i.e. moments after the CLI launches — and clobbers OSC- and user-set names
# alike. So the OSC 1 below only covers the stretch until the CLI starts,
# and retitle_iterm_tab re-asserts the name afterwards at the user level via
# AppleScript: post-launch user-level names survive job changes and are only
# recomputed at the next shell prompt, which never comes in --execute mode.
retitle_iterm_tab() {
    [[ "${TERM_PROGRAM:-}" == "iTerm.app" && -n "${ITERM_SESSION_ID:-}" ]] || return 0
    local uuid="${ITERM_SESSION_ID#*:}"
    ( for delay in 4 6 8 12 20 30; do
        sleep "$delay"
        osascript \
            -e 'on run argv' \
            -e 'tell application "iTerm2"' \
            -e 'repeat with w in windows' \
            -e 'repeat with t in tabs of w' \
            -e 'repeat with s in sessions of t' \
            -e 'if id of s is item 1 of argv then set name of s to item 2 of argv' \
            -e 'end repeat' -e 'end repeat' -e 'end repeat' \
            -e 'end tell' -e 'end run' \
            "$uuid" "$1"
    done ) &>/dev/null &!
}
if [[ "$launch_target" == plain && "${TERM_PROGRAM:-}" == "iTerm.app" && -t 1 ]]; then
    printf '\e]1;%s\a' "$session_name"
fi

# Report the current directory to iTerm2. iTerm2 normally learns the cwd
# from shell-integration prompt marks, but in --execute-style CLI modes no
# prompt ever runs, so features that rely on it (new tab/split in same
# directory, status-bar path, semantic history) would keep the pre-switch
# directory for the whole session.
report_iterm_cwd() {
    [[ "${TERM_PROGRAM:-}" == "iTerm.app" && -t 1 ]] || return 0
    printf '\e]1337;CurrentDir=%s\a' "$PWD"
}

# --- cmux launch -------------------------------------------------------------
# With --cmux the CLI runs in a cmux workspace named after the branch. cmux is
# a persistent GUI multiplexer (a separate app driven over a Unix socket), so
# the workspace outlives this terminal window and survives an app restart via
# cmux's session manifest — closing the window leaves the CLI running, and
# `--resume --cmux` returns to it. This call returns immediately rather than
# blocking on the CLI: cmux opens its own window and names the tab from --name,
# so none of the iTerm2 title/cwd machinery above applies. This path is only
# reached from a non-cmux terminal — when already inside a cmux surface the
# dispatch renames the current workspace and runs in place instead (see
# rename_cmux_workspace), never spawning a twin.
#
# PATH is forwarded with --env: the app is usually launched by macOS
# LaunchServices, whose environment predates the version managers this script
# eval'd. cmux applies --env to the workspace's shell and every later surface.
launch_in_cmux() {
    # The control socket only exists while the app runs; `cmux ping` fails
    # until then. `open -a cmux` starts it, then poll until the socket is up.
    if ! cmux ping >/dev/null 2>&1; then
        open -a cmux || { print -ru2 -- "could not launch cmux.app"; return 1; }
        local i
        for i in {1..50}; do
            cmux ping >/dev/null 2>&1 && break
            sleep 0.2
        done
        cmux ping >/dev/null 2>&1 \
            || { print -ru2 -- "cmux did not come up in time"; return 1; }
    fi

    # Reuse an already-open workspace of this name instead of spawning a twin —
    # but ONLY under --resume. cmux auto-titles every workspace after its active
    # surface, and that title embeds the cwd and running command (e.g.
    # "bin · in @_exec-in-worktrunk --cmux · <id>"). A bare substring match on
    # the branch slug therefore hits the *launching* workspace whenever the slug
    # echoes the work context ("worktrunk", "cmux", the dir name, ...). Left
    # ungated that made an ordinary --cmux launch select the current workspace
    # and return before workspace create ever ran — the CLI never opened. So gate
    # on $resume (matching the intent below) and drop the current workspace from
    # the candidates so a resume can't self-match either.
    if (( resume )); then
        local current existing
        current="$(cmux current-workspace 2>/dev/null)"
        existing="$(cmux workspace list 2>/dev/null \
            | grep -F -- "$session_name" \
            | grep -oE 'workspace:[0-9]+' \
            | grep -vxF -- "$current" | head -1)"
        if [[ -n "$existing" ]]; then
            print -r -- "cmux workspace: ${session_name} (existing)"
            cmux workspace select "$existing"
            return
        fi
    fi

    # Command line cmux types into the new workspace's shell. In shell mode
    # (empty cli) there is no --command: the workspace opens a plain shell in
    # the worktree, so --cmux works from the symlinks and sourced alike.
    local -a launch=("${cli[@]}" "${cli_args[@]}")
    local -a nw=(--name "$session_name" --cwd "$PWD"
                 --env "PATH=${PATH}" --focus true)
    (( ${#launch[@]} )) && nw+=(--command "${(j: :)${(@q)launch}}")
    print -r -- "cmux workspace: ${session_name}"
    cmux workspace create "${nw[@]}"
}

# --- cmux in-place -----------------------------------------------------------
# When the script is already running inside a cmux surface ($CMUX_WORKSPACE_ID
# set) there is no reason to spawn a twin workspace, so we retitle the one we're
# in — the cmux analogue of the iTerm2 tab retitle — and run the tool in place.
rename_cmux_workspace() {
    cmux workspace rename "$CMUX_WORKSPACE_ID" --title "$session_name" >/dev/null 2>&1
    print -r -- "cmux workspace: ${session_name} (in place)"
}

# --- herdr launch ------------------------------------------------------------
# With --herdr the CLI runs in a herdr workspace named after the branch. herdr
# is a client/server terminal multiplexer (tmux-like, driven over a Unix
# socket) whose workspaces can be git-worktree-aware: `worktree open`
# registers the checkout with herdr, so the workspace shows its branch and
# repo in the UI, herdr tracks the agent's idle/working/blocked state in the
# workspace list, and `herdr worktree remove` can reclaim the checkout later.
# Opening is idempotent per checkout path — reopening returns the existing
# workspace (already_open) instead of a twin — so --resume --herdr and a plain
# re-run on the same branch both land in the earlier workspace, with no name
# matching needed. Like the cmux path this returns immediately rather than
# blocking on the CLI: an attached herdr client shows the focused workspace,
# and without one the workspace waits in the server until `herdr` attaches.
launch_in_herdr() {
    # The socket API only answers while the server runs. There is no app to
    # open — clients attach to a headless server — so a missing server is
    # started detached here, from /, so a fresh server never sits in a
    # directory a later worktree cleanup deletes out from under it (the same
    # poisoned-cwd failure the tmux notes below describe).
    local started_server=0 i
    if ! herdr workspace list >/dev/null 2>&1; then
        (builtin cd / && herdr server &>/dev/null &!)
        for i in {1..50}; do
            herdr workspace list >/dev/null 2>&1 && break
            sleep 0.2
        done
        herdr workspace list >/dev/null 2>&1 \
            || { print -ru2 -- "herdr server did not come up in time"; return 1; }
        started_server=1
    fi

    # --path wants the worktree root (not whatever subdirectory we sit in) and
    # --cwd the repo's main checkout: herdr resolves the repo from the caller's
    # cwd, and a cwd inside the linked worktree itself makes the open fail with
    # worktree_not_found ("worktree actions start from the repo parent
    # workspace").
    local wt_root main_wt out
    wt_root="$(git rev-parse --show-toplevel 2>/dev/null)" || wt_root="$PWD"
    main_wt="$(git worktree list --porcelain 2>/dev/null | head -1 | cut -d' ' -f2-)"
    out="$(herdr worktree open --cwd "${main_wt:-$wt_root}" --path "$wt_root" \
        --label "$session_name" --focus 2>/dev/null)"
    if [[ -z "$out" ]] || jq -e '.error' <<<"$out" >/dev/null 2>&1; then
        print -ru2 -- "herdr worktree open failed: $(jq -r '.error.message // "no output"' <<<"$out" 2>/dev/null)"
        return 1
    fi
    if [[ "$(jq -r '.result.already_open' <<<"$out")" == true ]]; then
        print -r -- "herdr workspace: ${session_name} (existing)"
        return 0
    fi
    print -r -- "herdr workspace: ${session_name}"

    # The CLI is typed into the new workspace's shell (worktree open has no
    # --command). `pane run` joins its argv with spaces into one shell line,
    # so the words are (q)-quoted into a single argument. No PATH re-export
    # here, unlike cmux/tmux: the pane hosts an interactive login zsh whose
    # rc files rebuild PATH (mise & co.) before the line is read, and the
    # ~1 KB PATH pushed the line past the tty's cooked-mode limit (MAX_CANON,
    # 1024 bytes on macOS) — everything beyond it, Enter included, was dropped
    # and the truncated command sat unexecuted in the shell's edit buffer.
    # The line is typed only once the prompt is up: before zsh has switched
    # the tty to raw mode, keys land in the cooked buffer, are echoed raw and
    # show up a second time at the prompt. In shell mode (empty cli) there is
    # nothing to run and the workspace opens a plain shell in the worktree.
    #
    # The worktree-cleanup offer is chained after the CLI on the same line:
    # this script has long returned by the time the CLI exits, so the offer
    # has to run where the CLI ran. On removal the workspace is closed too —
    # its shell would otherwise sit in a deleted directory, and herdr keeps
    # showing a worktree that no longer exists.
    local -a launch=("${cli[@]}" "${cli_args[@]}")
    if (( ${#launch[@]} )); then
        local pane runout line
        pane="$(jq -r '.result.root_pane.pane_id // empty' <<<"$out")"
        for i in {1..50}; do
            [[ -n "${$(herdr pane read "$pane" --source visible 2>/dev/null)//[[:space:]]/}" ]] && break
            sleep 0.2
        done
        line="${(j: :)${(@q)launch}}"
        line+="; _offer-worktree-cleanup ${(q)wt_root} ${(q)branch}"
        line+=' && herdr workspace close "$HERDR_WORKSPACE_ID"'
        runout="$(herdr pane run "$pane" "$line" 2>&1)"
        jq -e '.error' <<<"$runout" >/dev/null 2>&1 \
            && print -ru2 -- "▲ could not start the CLI in ${pane}: $(jq -r '.error.message' <<<"$runout")"
    fi
    (( started_server )) && print -r -- "  (server was started headless — run \`herdr\` to attach)"
    return 0
}

# --- herdr in-place ----------------------------------------------------------
# Already inside a herdr pane ($HERDR_WORKSPACE_ID set), spawning a workspace
# from within would just make a twin — retitle the one we're in and run the
# tool in place, exactly like the cmux analogue above.
rename_herdr_workspace() {
    herdr workspace rename "$HERDR_WORKSPACE_ID" "$session_name" >/dev/null 2>&1
    print -r -- "herdr workspace: ${session_name} (in place)"
}

# --- tmux launch -------------------------------------------------------------
# With --tmux the CLI runs inside a tmux session named after the branch,
# regardless of the host terminal. The session is created detached first so PATH
# can be injected with -e (a pre-existing tmux server would otherwise hand the
# session its own stale environment, predating the version managers this script
# eval'd), then attached — or, when we are already inside tmux, switched to with
# switch-client, since an attach can't nest. A session of this name is reused
# rather than duplicated, so --tmux pairs with --resume to return to earlier work.
# The `=` target prefix forces an exact-name match instead of a prefix match.
#
# Pane cwd needs two defenses. Panes are forked from the tmux *server*, which
# lives as long as any session does and keeps the cwd it was started with; the
# first --tmux run of the day starts it implicitly from inside the just-created
# worktree, and when a later `wt` cleanup trashes that worktree the server is
# left sitting in a deleted directory. tmux (3.7b) then fails to apply `-c` to
# new panes at all: every pane starts with the dead cwd, and a Bun-based CLI
# like claude aborts on launch with a cryptic "ENOENT: Bun could not find a
# file" — the session dies the moment it is created and the attach below
# returns into a tab that closes before the error can be read. So (1) the pane
# command re-cds itself, which holds up even on a poisoned server, and (2) the
# client that may auto-start the server runs from /, so a fresh server never
# sits in a directory that can be deleted out from under it.
launch_in_tmux() {
    local tsess="$tmux_session"
    local -a launch=("${cli[@]}" "${cli_args[@]}")
    local wdir="$PWD"
    local -a panecmd
    if (( ${#launch[@]} )); then
        panecmd=(sh -c 'cd -- "$1" && shift && exec "$@"' - "$wdir" "${launch[@]}")
    else
        panecmd=(sh -c 'cd -- "$1" && exec "${SHELL:-/bin/zsh}" -l' - "$wdir")
    fi
    if tmux has-session -t "=$tsess" 2>/dev/null; then
        print -r -- "tmux session: ${tsess} (existing)"
    else
        (builtin cd / && tmux new-session -d -s "$tsess" -c "$wdir" -e "PATH=${PATH}" -- "${panecmd[@]}")
        print -r -- "tmux session: ${tsess}"
    fi
    if [[ -n "${TMUX:-}" ]]; then
        tmux switch-client -t "=$tsess"
    else
        # Not via _exec: it evals its args as one string, and zsh then treats
        # the bare `=<session>` word as EQUALS expansion (path lookup of a
        # command named after the session), which errors out and the attach
        # never runs — leaving the freshly created session detached.
        local attach_start=$SECONDS
        tmux attach-session -t "=$tsess"
        # A return within seconds with the session gone means the CLI crashed
        # on launch. A profile-spawned tab ("Close Sessions On End") vanishes
        # the moment this script exits, so hold it open until a key is pressed
        # to keep the evidence readable.
        if (( SECONDS - attach_start < 5 )) && ! tmux has-session -t "=$tsess" 2>/dev/null; then
            print -ru2 -- "▲ tmux session ${tsess} died right after launch — the CLI likely crashed on start"
            [[ -t 0 ]] && read -rsk1 '?  press any key to close '
        fi
    fi
}

# --- post-run worktree cleanup ----------------------------------------------
# The branch outlives the worktree, so once the tool exits a clean worktree is
# pure disk cost — `wt switch <branch>` recreates it on demand. Offer to drop
# it, keeping the branch so the work stays reachable. The offer itself lives
# in _offer-worktree-cleanup (dirty check, gitignored-count note, `wt remove
# --no-delete-branch`), a standalone script so the herdr launch can chain it
# onto the CLI's command line inside the workspace's own shell.
#
# Only the paths that block on the tool call this. A --cmux launch returns
# while the CLI still runs in its own workspace, a detached tmux session is
# still alive, and shell mode leaves the caller's own shell inside the
# worktree — removing any of those pulls the directory out from under a live
# process (and a tmux server left in a deleted cwd poisons every later pane).
# --herdr returns early too, but its pane runs the offer after the CLI on its
# own (see launch_in_herdr).
offer_worktree_cleanup() {
    # The worktree was the user's, entered before this script ran, so it is not
    # ours to reclaim — only ones we switched into are offered for removal.
    (( stay )) && return 0
    _offer-worktree-cleanup "$1" "$branch"
    return 0
}

# --- dispatch --------------------------------------------------------------
# Add another tool by dropping a case here and symlinking
# `<tool>-in-worktrunk` -> this file. `shell` is the no-CLI variant (sourced,
# no symlink): it just creates/switches the worktree without spawning a child
# process — the user stays in their original shell.
cli=()
cli_args=()
case "$mode" in
    claude-in-worktrunk|claude)
        # Claude Code keeps rewriting the terminal title while it runs, which
        # clobbers the session-name tab title set above. Route through `env`
        # to disable that for the child only — exporting here would leak into
        # the caller's shell when this script is sourced.
        cli=(env)
        cli_args=(CLAUDE_CODE_DISABLE_TERMINAL_TITLE=1
                  claude --dangerously-skip-permissions --name "$session_name")
        ;;
    opencode-in-worktrunk|opencode)
        cli=(opencode)
        cli_args=()
        ;;
    shell-in-worktrunk|shell)
        cli=()
        cli_args=()
        ;;
    *)
        print -ru2 -- "invoke via claude-in-worktrunk, opencode-in-worktrunk, or the shell-in-worktrunk function (got: $mode)"
        exit 1
        ;;
esac

# The wt wrapper loaded above does the post-switch `builtin cd`, so after
# this call the script (or the sourcing shell) sits inside the worktree and
# its path can be reported to iTerm2. That's why the switch and the CLI
# launch are separate steps rather than one `wt switch --execute`: --execute
# replaces the wt process with the CLI, so the worktree path would never be
# observable from here.
if (( stay )); then
    # Already in the right place — and in whichever subdirectory the user ran
    # this from, which is left alone rather than being reset to the worktree root.
    print -r -- "staying in '${PWD}' on ${branch}"
else
    _exec wt switch "$branch" "${create_args[@]}"
fi
worktree_path="$PWD"

case "$launch_target" in
    tmux)
        # tmux owns the terminal once attached; the iTerm2 machinery doesn't
        # apply. Session creation already pointed at the worktree via -c "$PWD".
        launch_in_tmux
        # attach also returns on a plain detach, which leaves the CLI running
        # in the session — only a session that is gone means the work is over.
        tmux has-session -t "=$tmux_session" 2>/dev/null \
            || offer_worktree_cleanup "$worktree_path"
        ;;
    cmux-inplace)
        # Already inside cmux: retitle this workspace after the branch and run
        # the tool right here — no new workspace, --cmux (if given) is a no-op.
        rename_cmux_workspace
        if (( ${#cli[@]} )); then
            _exec "${cli[@]}" "${cli_args[@]}"
            offer_worktree_cleanup "$worktree_path"
        fi
        ;;
    cmux-create)
        # cmux owns its own window and cwd (--cwd), so the iTerm2 title/cwd
        # re-asserters below don't apply — hand the worktree straight to cmux.
        launch_in_cmux
        ;;
    herdr-inplace)
        # Already inside herdr: retitle this workspace after the branch and run
        # the tool right here — no new workspace, --herdr (if given) is a no-op.
        rename_herdr_workspace
        if (( ${#cli[@]} )); then
            _exec "${cli[@]}" "${cli_args[@]}"
            offer_worktree_cleanup "$worktree_path"
        fi
        ;;
    herdr-create)
        # herdr owns the workspace's pane and cwd, so the iTerm2 title/cwd
        # machinery doesn't apply — register the worktree and return while the
        # CLI runs on in the server.
        launch_in_herdr
        ;;
    plain)
        report_iterm_cwd
        if (( ${#cli[@]} )); then
            # Only CLI modes get the re-asserter: in shell mode the prompt
            # returns and iTerm2's auto-naming would legitimately take over.
            retitle_iterm_tab "$session_name"
            _exec "${cli[@]}" "${cli_args[@]}"
            offer_worktree_cleanup "$worktree_path"
        fi
        ;;
esac
