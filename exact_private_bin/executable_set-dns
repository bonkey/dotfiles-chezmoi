#!/usr/bin/env zsh
# Sets the DNS servers of every enabled network service.
# Without arguments, toggles between the DHCP-provided servers and $default_preset.
# A change lasts $default_duration seconds unless -t or -s says otherwise.

source "${0:A:h}/_common.zsh"

default_preset=cloudflare
default_duration=60

# name, description, servers
presets=(
  cloudflare         "Cloudflare, no filtering"                     "1.1.1.1 1.0.0.1 2606:4700:4700::1111 2606:4700:4700::1001"
  cloudflare-malware "Cloudflare, blocks malware"                   "1.1.1.2 1.0.0.2 2606:4700:4700::1112 2606:4700:4700::1002"
  cloudflare-family  "Cloudflare, blocks malware and adult content" "1.1.1.3 1.0.0.3 2606:4700:4700::1113 2606:4700:4700::1003"
  google             "Google, no filtering"                         "8.8.8.8 8.8.4.4 2001:4860:4860::8888 2001:4860:4860::8844"
  quad9              "Quad9, blocks malware, validates DNSSEC"      "9.9.9.9 149.112.112.112 2620:fe::fe 2620:fe::9"
  adguard            "AdGuard, blocks ads, trackers and malware"    "94.140.14.14 94.140.15.15 2a10:50c0::ad1:ff 2a10:50c0::ad2:ff"
)

usage() {
  print "Usage: $script_name [-t SECONDS | -s] [status | dhcp | <preset> | <ip>...]"
  print "       $script_name --flush-dns"
  print "Without arguments, toggles between DHCP and $default_preset."
  print "Restores the previous servers after $default_duration seconds or on Ctrl-C."
  print "  -t SECONDS  restore after SECONDS instead"
  print "  -s          save the change\n\nPresets:"
  for name desc servers in $presets; do
    printf "  %-20s %s\n" $name $desc
  done
}

# Enabled services bound to a device. VPN services such as Tailscale have none.
services() {
  networksetup -listnetworkserviceorder | awk '
    /^\([0-9]+\) / { sub(/^\([0-9]+\) /, ""); name = $0; next }
    /Device: [^)]/ && name != "" { print name }
    { name = "" }'
}

# Prints the manually set servers of a service, or nothing when it uses DHCP.
manual_dns() {
  networksetup -getdnsservers $1 | grep -v "aren't any"
}

flush_dns() {
  sudo dscacheutil -flushcache
  sudo killall -HUP mDNSResponder
}

show_status() {
  local svc servers
  for svc in "${(@f)$(services)}"; do
    servers=(${(f)"$(manual_dns $svc)"})
    print "$svc: ${servers:-DHCP}"
  done
}

# Usage: set_dns <label> <server>...
# The single server "empty" restores the DHCP-provided servers.
# With a non-zero $duration, restores each service's previous servers after it.
set_dns() {
  local label=$1 svc
  local -A previous
  shift
  for svc in "${(@f)$(services)}"; do
    previous[$svc]=${$(manual_dns $svc):-empty}
    sudo networksetup -setdnsservers $svc "$@" || exit 1
  done
  flush_dns
  (( duration )) || { print "DNS: $label"; return }

  print "DNS: $label for ${duration}s, Ctrl-C restores it now"
  # Ctrl-C ends only the sleep; the script goes on to restore.
  trap : INT TERM HUP
  sleep $duration
  for svc in ${(k)previous}; do
    sudo networksetup -setdnsservers $svc ${=previous[$svc]}
  done
  flush_dns
  print "DNS: restored"
}

set_preset() {
  for name desc servers in $presets; do
    [[ $name == $1 ]] && { set_dns $name ${=servers}; return }
  done
  return 1
}

zparseopts -D -E -- t:=opt_time s=opt_save
duration=${opt_time[-1]:-$default_duration}
(( $#opt_save )) && duration=0
[[ $duration == <-> ]] || { log_error "Invalid duration: $duration"; exit 1 }

case $1 in
  -h|--help) usage ;;
  --flush-dns) flush_dns; print "DNS: cache flushed" ;;
  status) show_status ;;
  dhcp) set_dns DHCP empty ;;
  "")
    for svc in "${(@f)$(services)}"; do
      [[ -n $(manual_dns $svc) ]] && { set_dns DHCP empty; exit }
    done
    set_preset $default_preset ;;
  *)
    set_preset $1 && exit
    for ip in "$@"; do
      [[ $ip =~ '^[0-9a-fA-F]*[.:][0-9a-fA-F.:]*$' ]] || { log_error "Unknown preset or address: $ip"; usage; exit 1 }
    done
    set_dns "$*" "$@" ;;
esac
