#!/usr/bin/env python3
"""Open, resolve, build, and kill Xcode projects from the shell.

Subcommands (with the ~/.aliases one-liners that call them):

  open    [PROJ] [-r]                    open with the selected Xcode              .x
  resolve [PROJ] [SCHEME] [-l] [--remove-package-resolved]
                                         clean + resolve package dependencies      .xcr
  build   [PROJ] [SCHEME] [-r] [xcodebuild args...]
                                         build for the iOS Simulator               .xrb
  kill    [--xcode] [--xcodebuild]       pkill -9 Xcode and/or xcodebuild          .xk / .xkb / .xkk

PROJ defaults to the nearest *.xcworkspace or *.xcodeproj below the current
directory, walking breadth-first: the shallowest match wins, a workspace beats a
project, and Package.swift is accepted in the current directory only. SCHEME
defaults to the project name. `open` honors a .xcode-version file by running
`xcodes select`. -r/--resolve runs `resolve` first. --kill-xcode and
--kill-xcodebuild run `kill` first; `resolve` always kills Xcode because it
deletes workspace-state.json files that a running Xcode would rewrite.
"""

import argparse
import shlex
import shutil
import subprocess
import sys
import time
from pathlib import Path

DERIVED_DATA = Path.home() / "Library/Developer/Xcode/DerivedData"
DESTINATION = "generic/platform=iOS Simulator"
PROJECT_SUFFIXES = (".xcworkspace", ".xcodeproj")
SKIP_DIRS = {"node_modules", "Pods", "Carthage", "DerivedData", "build", "vendor"}
SEARCH_MAX_DEPTH = 8

TTY = sys.stdout.isatty()


def paint(code: str, text: str) -> str:
    return f"\033[{code}m{text}\033[0m" if TTY else text


PREFIX = paint("1;34", ">>> ")


def log(msg: str) -> None:
    print(f"{PREFIX}{msg}.", flush=True)


def fail(msg: str, code: int = 1) -> "NoReturn":
    print(f"{PREFIX}Error: {paint('1;41;37', msg)}.", file=sys.stderr, flush=True)
    sys.exit(code)


def run(cmd: list, check: bool = True, pipe_to: list | None = None) -> int:
    """Run a command with the same logging as _exec in _common.zsh."""
    shown = shlex.join(cmd) + (f" | {shlex.join(pipe_to)}" if pipe_to else "")
    print(f"{PREFIX}Executing: {paint('1;44;37', shown)}", flush=True)
    start = time.monotonic()
    if pipe_to:
        producer = subprocess.Popen(cmd, stdout=subprocess.PIPE)
        consumer = subprocess.Popen(pipe_to, stdin=producer.stdout)
        producer.stdout.close()
        consumer.wait()
        rc = producer.wait()
    else:
        rc = subprocess.run(cmd).returncode
    log(f"Elapsed: {paint('1;34', f'{time.monotonic() - start:.3f} s')}")
    if rc and check:
        fail(f"'{shown}' exited with {rc}. Check the output above", rc)
    return rc


# --- project discovery ---------------------------------------------------------


def locate(given: str | None) -> Path:
    """Explicit path, else breadth-first search below cwd."""
    if given:
        path = Path(given)
        if not path.exists():
            fail(f"'{given}' not found")
        return path

    cwd = Path.cwd()
    package = cwd / "Package.swift"
    level = [cwd]
    for _ in range(SEARCH_MAX_DEPTH):
        next_level, hits = [], []
        for directory in level:
            try:
                children = sorted(directory.iterdir())
            except OSError:
                continue
            for child in children:
                if not child.is_dir():
                    continue
                if child.suffix in PROJECT_SUFFIXES:
                    hits.append(child)
                elif not child.name.startswith(".") and child.name not in SKIP_DIRS:
                    next_level.append(child)
        if hits:
            best = min(hits, key=lambda p: p.suffix != ".xcworkspace")
            return best.relative_to(cwd)
        if package.is_file():
            return package.relative_to(cwd)
        level = next_level
    fail(f"No xcworkspace/xcodeproj below {cwd}, nor Package.swift in it")


def build_target(proj: Path, scheme: str | None) -> tuple[str, str, str]:
    """(-workspace|-project, path, scheme) for xcodebuild."""
    if proj.suffix not in PROJECT_SUFFIXES or not proj.is_dir():
        fail(f"'{proj}' is not an .xcworkspace or .xcodeproj")
    flag = "-workspace" if proj.suffix == ".xcworkspace" else "-project"
    return flag, str(proj), scheme or proj.stem


# --- xcode selection -------------------------------------------------------------


def xcode_version() -> str:
    out = subprocess.run(
        ["xcrun", "xcodebuild", "-version"], capture_output=True, text=True
    ).stdout
    first = out.splitlines()[0] if out else ""
    return first.removeprefix("Xcode ").strip()


def select_xcode_from_file() -> None:
    version_file = Path(".xcode-version")
    if not version_file.is_file():
        return
    wanted = version_file.read_text().strip()
    if wanted and wanted not in xcode_version():
        log(f"Selecting Xcode {wanted}")
        run(["xcodes", "select", wanted])


def xcode_app() -> str:
    dev = subprocess.run(
        ["xcode-select", "-p"], capture_output=True, text=True, check=True
    ).stdout.strip()
    return dev.removesuffix("/Contents/Developer")


# --- actions ----------------------------------------------------------------------


def kill(xcode: bool, xcodebuild: bool) -> None:
    """pkill -9 the requested processes; nothing running is not an error."""
    for enabled, name in ((xcode, "Xcode"), (xcodebuild, "xcodebuild")):
        if enabled:
            run(["pkill", "-9", "-x", name], check=False)


def kill_from_flags(args: argparse.Namespace) -> None:
    kill(getattr(args, "kill_xcode", False), getattr(args, "kill_xcodebuild", False))


def resolve(
    proj: Path,
    scheme: str | None = None,
    list_schemes: bool = False,
    remove_package_resolved: bool = False,
) -> None:
    flag, path, scheme = build_target(proj, scheme)
    xcodebuild = ["xcrun", "xcodebuild", "-destination", DESTINATION]

    if list_schemes:
        log("Listing available schemes")
        run(xcodebuild + ["-list", flag, path])
        return

    kill(xcode=True, xcodebuild=False)
    time.sleep(0.5)

    log("Removing workspace state files")
    for state in DERIVED_DATA.glob(f"{proj.stem}*/**/workspace-state.json"):
        state.unlink()
        print(state)

    if remove_package_resolved:
        for resolved in proj.rglob("Package.resolved"):
            resolved.unlink()
            print(resolved)

    run(xcodebuild + ["clean", flag, path, "-scheme", scheme])
    run(xcodebuild + ["-resolvePackageDependencies", flag, path, "-scheme", scheme])


def cmd_open(args: argparse.Namespace) -> None:
    kill_from_flags(args)
    proj = locate(args.project)
    select_xcode_from_file()
    app = xcode_app()
    log(f"Opening {proj} with {app} ({paint('1;32', xcode_version())})")
    if args.resolve:
        resolve(proj)
    run(["open", "-a", app, str(proj)])


def cmd_resolve(args: argparse.Namespace) -> None:
    kill_from_flags(args)
    resolve(locate(args.project), args.scheme, args.list, args.remove_package_resolved)


def cmd_build(args: argparse.Namespace, extra: list[str]) -> None:
    kill_from_flags(args)
    proj = locate(args.project)
    if args.resolve:
        resolve(proj, args.scheme)
    flag, path, scheme = build_target(proj, args.scheme)
    cmd = ["xcrun", "xcodebuild", flag, path, "-scheme", scheme, "-destination", DESTINATION]
    beautify = ["xcbeautify", "-q", "--disable-logging"] if shutil.which("xcbeautify") else None
    run(cmd + extra, pipe_to=beautify)


def cmd_kill(args: argparse.Namespace) -> None:
    both = not (args.xcode or args.xcodebuild)
    kill(args.xcode or both, args.xcodebuild or both)


# --- cli --------------------------------------------------------------------------


def main(argv: list[str]) -> None:
    parser = argparse.ArgumentParser(
        prog="xcode-proj",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = parser.add_subparsers(dest="command", required=True, metavar="COMMAND")

    def add_project_command(
        name: str, help_text: str, scheme: bool, resolve_flag: bool
    ) -> argparse.ArgumentParser:
        p = sub.add_parser(name, help=help_text)
        p.add_argument("project", nargs="?", help="xcworkspace / xcodeproj / Package.swift")
        if scheme:
            p.add_argument("scheme", nargs="?", help="defaults to the project name")
        if resolve_flag:
            p.add_argument("-r", "--resolve", action="store_true", help="run `resolve` first")
        p.add_argument("--kill-xcode", action="store_true", help="pkill -9 Xcode first")
        p.add_argument("--kill-xcodebuild", action="store_true", help="pkill -9 xcodebuild first")
        return p

    add_project_command("open", "open the project with the selected Xcode", False, True)
    p_resolve = add_project_command(
        "resolve", "clean and resolve package dependencies (kills Xcode)", True, False
    )
    p_resolve.add_argument("-l", "--list", action="store_true", help="list schemes and exit")
    p_resolve.add_argument(
        "--remove-package-resolved", action="store_true", help="delete Package.resolved files first"
    )
    add_project_command(
        "build", "build for the iOS Simulator; extra args go to xcodebuild", True, True
    )
    p_kill = sub.add_parser("kill", help="pkill -9 Xcode and/or xcodebuild (default: both)")
    p_kill.add_argument("--xcode", action="store_true")
    p_kill.add_argument("--xcodebuild", action="store_true")

    args, extra = parser.parse_known_args(argv)
    if extra and args.command != "build":
        parser.error(f"unrecognized arguments: {' '.join(extra)}")

    {"open": cmd_open, "resolve": cmd_resolve, "kill": cmd_kill}.get(
        args.command, lambda a: cmd_build(a, extra)
    )(args)


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except KeyboardInterrupt:
        sys.exit(130)
