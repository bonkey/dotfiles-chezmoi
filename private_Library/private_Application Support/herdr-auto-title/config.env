# herdr-auto-title (kryptamine/herdr-auto-title). Read once at server start.
# Tab label = "<dir> › <activity>"; the window title mirrors it via
# ui.window_title = "{tab}" in ~/.config/herdr/config.toml.

# No "3 · " tab position in front; the tab bar already numbers tabs.
HERDR_AUTO_TITLE_POSITION=false

# No agent name: "herdr › foo", not "herdr › claude › foo". A silent agent
# pane is named after its directory instead.
HERDR_AUTO_TITLE_AGENT_NAME=false
