window-theme = system
config-file = ?auto/theme.ghostty

# font-family = "CodeNewRoman Nerd Font Mono"
font-family = "Google Sans Code NF"
font-size = 16
adjust-cell-height = 2

background-opacity = 0.96
background-blur = 10
unfocused-split-opacity = 0.2

copy-on-select = clipboard
mouse-hide-while-typing = true
link-url = true

window-padding-x = 8
window-padding-y = 8
window-width = 130
window-height = 40
window-theme = auto
window-new-tab-position = end
window-save-state = never
window-colorspace = display-p3

scrollback-limit = 50000000

macos-icon = official

# "native", "transparent", "tabs", and "hidden".
macos-titlebar-style = transparent

quit-after-last-window-closed = true

keybind = global:alt+backquote=toggle_quick_terminal
quick-terminal-position = center
quick-terminal-size = 40%,40%
quick-terminal-screen = mouse
quick-terminal-space-behavior = move

auto-update = download
auto-update-channel = stable


### Keybindings
# super==cmd, alt==opt
# move between tabs is cmd+arrow
keybind = super+left=previous_tab
keybind = super+right=next_tab
# move between panes is cmd+opt+arrow
keybind = super+alt+left=goto_split:previous
keybind = super+alt+right=goto_split:next
