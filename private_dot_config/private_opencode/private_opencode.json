{
  "plugin": [
    "@plannotator/opencode@latest"
  ],
  "disabled_providers": ["anthropic", "openrouter", "perplexity"],
  "formatter": {
    "swiftformat": {
      "command": ["swiftformat", "$FILE"],
      "extensions": [".swift"]
    }
  },
  "mcp": {
    "tavily": {
      "type": "remote",
      "url": "https://mcp.tavily.com/mcp/?tavilyApiKey=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",
      "enabled": true
    },
    "firecrawl": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "firecrawl-mcp"
      ],
      "environment": {
        "FIRECRAWL_API_KEY": "fc-437f5e83462f48a4b29dde7b4a5726cf"
      },
      "enabled": true
    },
    "deepwiki": {
      "url": "https://mcp.deepwiki.com/mcp",
      "type": "remote",
      "enabled": true
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp?exaApiKey=e1fd55ef-fe55-456d-9cf4-25b9d88ee62b",
      "enabled": true
    },
    "morph": {
      "type": "local",
      "command": [
        "npx",
        "--prefer-offline",
        "-y",
        "@morphllm/morphmcp"
      ],
      "environment": {
        "MORPH_API_KEY": "sk-r3YvbcbUfHB_2P6ZKZzB8TvjtXAH-nBO5L5JIQbrkgwVvYk4"
      },
      "enabled": true
    },
    "agentsview": {
      "type": "local",
      "command": [
        "agentsview",
        "mcp"
      ],
      "enabled": true
    },
    "contentful": {
      "type": "remote",
      "url": "https://mcp.contentful.com/mcp",
      "enabled": true
    }
  },
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["node_modules/@morphllm/opencode-morph-plugin/instructions/morph-tools.md"]
}
