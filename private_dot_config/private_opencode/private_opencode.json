{
  "plugin": [
    "@plannotator/opencode@latest"
  ],
  "disabled_providers": ["anthropic", "openrouter", "perplexity"],
  "formatter": {
    "swiftformat": {
      "command": ["swiftformat", "$FILE"],
      "extensions": [".swift"]
    }
  },
  "mcp": {
    "tavily": {
      "type": "remote",
      "url": "https://mcp.tavily.com/mcp/?tavilyApiKey=<TAVILY_API_KEY_REDACTED>",
      "enabled": true
    },
    "firecrawl": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "firecrawl-mcp"
      ],
      "environment": {
        "FIRECRAWL_API_KEY": "<FIRECRAWL_API_KEY_REDACTED>"
      },
      "enabled": true
    },
    "deepwiki": {
      "url": "https://mcp.deepwiki.com/mcp",
      "type": "remote",
      "enabled": true
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp?exaApiKey=<EXA_API_KEY_REDACTED>",
      "enabled": true
    },
    "morph": {
      "type": "local",
      "command": [
        "npx",
        "--prefer-offline",
        "-y",
        "@morphllm/morphmcp"
      ],
      "environment": {
        "MORPH_API_KEY": "<MORPH_API_KEY_REDACTED>"
      },
      "enabled": true
    },
    "agentsview": {
      "type": "local",
      "command": [
        "agentsview",
        "mcp"
      ],
      "enabled": true
    },
    "contentful": {
      "type": "remote",
      "url": "https://mcp.contentful.com/mcp",
      "enabled": true
    }
  },
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["node_modules/@morphllm/opencode-morph-plugin/instructions/morph-tools.md"]
}
