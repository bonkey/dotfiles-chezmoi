{
  "plugin": [
    "@plannotator/opencode@latest"
  ],
  "disabled_providers": ["anthropic", "openrouter", "perplexity"],
  "formatter": {
    "swiftformat": {
      "command": ["swiftformat", "$FILE"],
      "extensions": [".swift"]
    }
  },
  "mcp": {
    "tavily": {
      "url": "https://mcp.tavily.com/mcp/?tavilyApiKey=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",
      "type": "remote",
      "enabled": true
    },
    "firecrawl": {
      "command": ["npx", "-y", "firecrawl-mcp"],
      "type": "local",
      "environment": {
        "FIRECRAWL_API_KEY": "fc-6df4241874cb4f178d9f6a1ca12eb839"
      },
      "enabled": true
    },
    "deepwiki": {
      "url": "https://mcp.deepwiki.com/mcp",
      "type": "remote",
      "enabled": true
    },
    "exa": {
      "url": "https://mcp.exa.ai/mcp?exaApiKey=26a2776b-7f18-4bc5-9cdc-0538bd68dda9",
      "type": "remote",
      "enabled": true
    },
    "linear": {
      "url": "https://mcp.linear.app/mcp",
      "type": "remote",
      "enabled": true
    },
    "morph": {
      "type": "local",
      "command": [
        "npx",
        "--prefer-offline",
        "-y",
        "@morphllm/morphmcp"
      ],
      "environment": {
        "MORPH_API_KEY": "sk-ljlfNyjQxepMydfprVKXLJ5S6dRciCNqMPrmKbJllnRU1hya"
      },
      "enabled": true
    },
    "agentsview": {
      "type": "local",
      "command": [
        "agentsview",
        "mcp"
      ],
      "enabled": true
    }
  },
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["node_modules/@morphllm/opencode-morph-plugin/instructions/morph-tools.md"]
}
