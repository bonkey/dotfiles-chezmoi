#!/usr/bin/env zsh

set +o pipefail

source_dir=${CHEZMOI_SOURCE_DIR:-${0:A:h}}
file=$source_dir/${CHEZMOI_SOURCE_FILE:-${0:t}}

# hash: {{ include .chezmoi.sourceFile | sha256sum }} - forces a run when the skill list changes
source_hash="{{ include .chezmoi.sourceFile | sha256sum }}"

source "$source_dir/exact_private_bin/_common.zsh"

skills_to_remove=(
    cass
    i-have-adhd

    # covered by the axiom plugin (see run_111); from wondelai/skills
    ios-hig-design

    # renamed upstream in bonkey/skills (captains-log, plugin-forge)
    decision-log
    claude-plugin-creator
)

# whole repos to purge: every skill they installed is looked up in the
# skill->source map (~/.agents/.skill-lock.json) and removed; the skills
# CLI itself has no source-level remove
sources_to_remove=(
    # WIN org internal toolkit; its ios skills are covered by axiom
    wisdom-in-a-nutshell/agents

    # covered by axiom
    twostraws/swiftui-agent-skill
    twostraws/swift-concurrency-agent-skill
    twostraws/swift-testing-agent-skill

    subsy/ralph-tui
)

skills=(
    # ios
    nonameplum/agent-skills@swift-docc

    # personal
    bonkey/skills
    bonkey/skills-private

    # control
    herdrdev/herdr@herdr

    rebelytics/one-skill-to-rule-them-all@task-observer

    mattpocock/skills@grill-me
    mattpocock/skills@wayfinder

    dietrichgebert/ponytail
    wondelai/skills

    elevenlabs/skills

    humanlayer/skills@show-me
)

for skill in "${skills[@]}"; do
    if [[ "$skill" == *@* ]]; then
        package="${skill%@*}"
        skill_name="${skill##*@}"
        exec_unless_recently_modified $file "npx -y skills add $package --skill $skill_name --global --yes" $source_hash
    else
        exec_unless_recently_modified $file "npx -y skills add $skill --global --yes" $source_hash
    fi
done

# removals run after adds so bundle installs can't resurrect removed skills
for skill in "${skills_to_remove[@]}"; do
    exec_unless_recently_modified $file "npx -y skills remove $skill --global --yes" $source_hash
done

for src in "${sources_to_remove[@]}"; do
    exec_unless_recently_modified $file "jq -r --arg src $src '.skills | to_entries[] | select(.value.source == \$src) | .key' ~/.agents/.skill-lock.json | xargs -I{} npx -y skills remove {} --global --yes" $source_hash
done

exec_unless_recently_modified $file "npx -y skills update --global" $source_hash
