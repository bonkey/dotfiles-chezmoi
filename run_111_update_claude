#!/usr/bin/env zsh

source_dir=${CHEZMOI_SOURCE_DIR:-${0:A:h}}
file=$source_dir/${CHEZMOI_SOURCE_FILE:-${0:t}}

source "$source_dir/exact_private_bin/_common.zsh"

set +o pipefail

if unless_recently_modified $file ; then
    claude update

    marketplaces=(
        edwardsanchez/MotionEyes
        Iron-Ham/XcodePreviews
        CharlesWiltgen/Axiom
        max-sixty/worktrunk
        ayghri/i-have-adhd
    )

    plugins=(
        claude-code-setup@claude-plugins-official
        motioneyes@motioneyes
        preview-build@preview-build
        axiom@axiom-marketplace
        worktrunk@worktrunk
        i-have-adhd@i-have-adhd
    )

    for marketplace in "${marketplaces[@]}"; do
        claude plugin marketplace add "$marketplace"
    done

    for plugin in "${plugins[@]}"; do
        claude plugin install "$plugin"
    done
fi
