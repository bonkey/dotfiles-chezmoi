#!/usr/bin/env zsh

# hour: {{ now.Format "2006-01-02T15" }} - changes hourly, so this runs hourly as well as on every edit
source "{{- .chezmoi.sourceDir}}/exact_private_bin/_common.zsh"

# skillet reaches gists through gh. mise installs both, and on a fresh machine
# it runs after this script.
for tool in skillet gh; do
    if ! command -v $tool >/dev/null; then
        log_message "$tool not found, skipping the skills update"
        exit 0
    fi
done

# The pull replaces the local catalog with the one in the gist that
# config.toml names, fetches all sources and syncs the global links.
_exec "skillet gist pull"
