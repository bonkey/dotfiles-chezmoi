#!/usr/bin/env zsh

set +o pipefail

# hour: {{ now.Format "2006-01-02T15" }} - changes hourly, so this runs hourly as well as on every edit
source "{{- .chezmoi.sourceDir}}/exact_private_bin/_common.zsh"

skills_to_remove=(
    cass
    i-have-adhd

    # covered by the axiom plugin (see run_111); from wondelai/skills
    ios-hig-design

    # renamed upstream in bonkey/skills (captains-log, plugin-forge)
    decision-log
    claude-plugin-creator
)

# whole repos to purge: every skill they installed is looked up in the
# skill->source map (~/.agents/.skill-lock.json) and removed; the skills
# CLI itself has no source-level remove
sources_to_remove=(
    # WIN org internal toolkit; its ios skills are covered by axiom
    wisdom-in-a-nutshell/agents

    # covered by axiom
    twostraws/swiftui-agent-skill
    twostraws/swift-concurrency-agent-skill
    twostraws/swift-testing-agent-skill

    subsy/ralph-tui
)

skills=(
    # ios
    nonameplum/agent-skills@swift-docc

    # personal
    bonkey/skills
    bonkey/skills-private

    # control
    herdrdev/herdr@herdr

    rebelytics/one-skill-to-rule-them-all@task-observer

    mattpocock/skills@grill-me
    mattpocock/skills@wayfinder

    dietrichgebert/ponytail
    wondelai/skills

    elevenlabs/skills

    humanlayer/skills@show-me
)

lock=~/.agents/.skill-lock.json

# skill name installed? (lock file may not exist on a fresh machine)
_has_skill() {
    [[ -f $lock ]] && jq -e --arg k "$1" '.skills[$k] != null' "$lock" >/dev/null
}

# any skill from this repo installed?
_has_source() {
    [[ -f $lock ]] && jq -e --arg src "$1" '[.skills[] | select(.source == $src)] | length > 0' "$lock" >/dev/null
}

# adds only run for what is missing; `skills update` at the end refreshes the rest
for skill in "${skills[@]}"; do
    if [[ "$skill" == *@* ]]; then
        package="${skill%@*}"
        skill_name="${skill##*@}"
        _has_skill "$skill_name" && continue
        _exec "npx -y skills add $package --skill $skill_name --global --yes"
    else
        _has_source "$skill" && continue
        _exec "npx -y skills add $skill --global --yes"
    fi
done

# removals run after adds so bundle installs can't resurrect removed skills
for skill in "${skills_to_remove[@]}"; do
    _has_skill "$skill" || [[ -d ~/.agents/skills/$skill ]] || continue
    _exec "npx -y skills remove $skill --global --yes"
done

for src in "${sources_to_remove[@]}"; do
    _has_source "$src" || continue
    _exec "jq -r --arg src $src '.skills | to_entries[] | select(.value.source == \$src) | .key' $lock | xargs -I{} npx -y skills remove {} --global --yes"
done

_exec "npx -y skills update --global"
