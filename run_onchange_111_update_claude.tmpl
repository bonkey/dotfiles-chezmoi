#!/usr/bin/env zsh

# hour: {{ now.Format "2006-01-02T15" }} - changes hourly, so this runs hourly as well as on every edit
source "{{- .chezmoi.sourceDir}}/exact_private_bin/_common.zsh"

set +o pipefail

claude update

marketplaces=(
    CharlesWiltgen/Axiom
    max-sixty/worktrunk
    hellosverre/claude-skins
    JayDoubleu/aside
    sirkitree/pinboard
)

plugins=(
    axiom@axiom-marketplace
    worktrunk@worktrunk
    superpowers@claude-plugins-official
    skins@hellosverre-mods
    aside@aside
    pinboard@pinboard
)

for marketplace in "${marketplaces[@]}"; do
    claude plugin marketplace add "$marketplace"
done

for plugin in "${plugins[@]}"; do
    claude plugin install "$plugin"
done
