#!/usr/bin/env zsh

set +o pipefail

# hour: {{ now.Format "2006-01-02T15" }} - changes hourly, so this runs hourly as well as on every edit
source "{{- .chezmoi.sourceDir}}/exact_private_bin/_common.zsh"

# Plugin catalog

plugins=(
    # session desk: search and resume past Claude/Codex/Cursor sessions into a herdr tab
    nicosuave/memex
    # mirrors the focused workspace/tab/agent into the outer terminal window title
    rjyo/herdr-window-title-sync
    # picks files/URLs visible on screen (ctrl+shift+a / ctrl+e) and opens them beside the pane
    iurysza/termscope
    # wt-backed worktree switch/create/remove pickers with lifecycle hooks (prefix+shift+g/c/d)
    devashish2203/herdr-worktrunk
    # Projects (workspace templates), Quick Actions fuzzy launcher, worktree auto-layouts
    cloudmanic/herdr-plus
    # read-only git-aware file/diff/markdown viewer in a split (prefix+f)
    smarzban/herdr-file-viewer
    # persistent diff-review pane beside the chat; line comments sent to the agent input (cmd+r)
    persiyanov/herdr-reviewr
    # real Chromium rendered inside a pane via kitty graphics
    zenbu-labs/terminal-browser/herdr-plugin
    # Claude Code hook reporting the session title (/rename or auto summary) as pane metadata
    bcihanc/herdr-claude-session-title
    # agent-summoned blocking diff review via the "annotator" MCP server registered below
    JonasBaeumer/herdr-file-annotator
    # hunk-based diff review with inline comments round-tripped to the agent (prefix+shift+h/s)
    jhochenbaum/herdr-hunk-diff
    # annotate terminal text, review markdown docs and the agent's replies (plannotator-tui)
    plannotator/herdr-annotate
    # daemon + sidebar cards with live agent state, model, context %, and cost
    winoooops/herdr-agent-watcher
)

post_update_actions=(
    bcihanc.claude-session-title.install
    rjyo.window-title-sync.refresh
    # installing into a running herdr does not start the watcher daemon - (re)start it
    herdr-agent-watcher.restart-daemon
)

# Plugin-specific integrations

configure_file_annotator() {
    local plugin_root executable
    plugin_root=$(herdr plugin list --plugin jonasbaeumer.file-annotator --json 2>/dev/null | jq -r '.result.plugins[0].plugin_root // empty')
    executable=$plugin_root/bin/herdr-annotator

    if [[ ! -x "$executable" ]]; then
        log_error "Cannot register annotator MCP server: executable not found at $executable"
        return 1
    fi

    # add fails when the server is already registered, so drop any existing
    # entry first - this also refreshes the path when a plugin update moves
    # the hashed install dir
    if (( $+commands[claude] )); then
        claude mcp remove --scope user annotator &> /dev/null
        _exec "claude mcp add --scope user annotator -- '$executable' mcp"
    fi
    if (( $+commands[codex] )); then
        codex mcp remove annotator &> /dev/null
        _exec "codex mcp add annotator -- '$executable' mcp"
    fi
    if (( $+commands[gemini] )); then
        gemini mcp remove --scope user annotator &> /dev/null
        _exec "gemini mcp add --scope user annotator '$executable' mcp"
    fi
}

configure_hunk_keybindings() {
    _exec "herdr plugin action invoke setup-keys --plugin jhochenbaum.hunkdiff"
}

# Lets agents request plannotator-tui reviews themselves. Installs once into
# ~/.agents/skills (symlinked into Claude Code and friends); skipped when present.
install_plannotator_tui_skill() {
    [[ -d ~/.agents/skills/plannotator-tui ]] && return 0
    _exec "npx -y skills add plannotator/herdr-annotate --skill plannotator-tui -g < /dev/null"
}

configure_plugin_integrations() {
    configure_file_annotator
    configure_hunk_keybindings
    install_plannotator_tui_skill
}

# Core update lifecycle

stopped_server=0
outdated_plugins=()

server_running() {
    herdr status server 2>/dev/null | grep -q '^status: running'
}

# A plugin is outdated when it is not installed or its resolved commit differs
# from the remote HEAD. Unreachable remotes count as up to date so a flaky
# network never triggers a server stop.
find_outdated_plugins() {
    local installed_json spec parts owner repo installed remote
    installed_json=$(herdr plugin list --json 2>/dev/null)

    for spec in "${plugins[@]}"; do
        parts=(${(s:/:)spec})
        owner=$parts[1]
        repo=$parts[2]

        installed=$(jq -r --arg o "$owner" --arg r "$repo" \
            '.result.plugins[].source | select(.owner==$o and .repo==$r) | .resolved_commit' \
            <<<"$installed_json")

        if [[ -z "$installed" ]]; then
            outdated_plugins+=("$spec")
            continue
        fi

        remote=$(git ls-remote "https://github.com/$owner/$repo" HEAD 2>/dev/null | awk '{print $1}')
        if [[ -z "$remote" ]]; then
            log_message "Cannot reach github.com/$owner/$repo, assuming up to date"
        elif [[ "$remote" != "$installed" ]]; then
            outdated_plugins+=("$spec")
        fi
    done
}

stop_server_with_consent() {
    server_running || return 0

    if [[ "${HERDR_ENV-}" == "1" || -n "${HERDR_PANE_ID-}" ]]; then
        log_message "Running inside a herdr pane - stopping the server would kill this terminal. Outside herdr, run: chezmoi state delete --bucket=entryState --key=$HOME/115_update_herdr && chezmoi apply"
        exit 0
    fi

    log_message "Plugin update needs the herdr server stopped. Current sessions"
    herdr session list

    if [[ ! -t 0 ]]; then
        log_message "Non-interactive run - leaving herdr server and its sessions alone, skipping plugin update"
        exit 0
    fi

    local reply
    if ! read -q "reply?Stop herdr server and kill the sessions above? [y/N] "; then
        print
        log_message "Keeping herdr server running, skipping plugin update"
        exit 0
    fi
    print

    _exec "herdr server stop"
    stopped_server=1
}

start_server_back() {
    [[ $stopped_server -eq 1 ]] || return 0

    log_message "Starting herdr server back in the background"
    herdr server < /dev/null &> /dev/null &!

    local i
    for i in {1..20}; do
        server_running && return 0
        sleep 0.5
    done
    log_error "herdr server did not come back up, start it manually with 'herdr'"
}

reload_server_config() {
    server_running || return 0
    _exec "herdr server reload-config"
}

# Main

find_outdated_plugins

if (( ${#outdated_plugins} == 0 )); then
    log_message "All herdr plugins are up to date"
    configure_plugin_integrations
    reload_server_config
    exit 0
fi

log_message "Outdated plugins: ${outdated_plugins[*]}"

stop_server_with_consent

for plugin in "${outdated_plugins[@]}"; do
    _exec "herdr plugin install '$plugin' --yes"
done

start_server_back

for action in "${post_update_actions[@]}"; do
    _exec "herdr plugin action invoke '$action'"
done

configure_plugin_integrations
reload_server_config
